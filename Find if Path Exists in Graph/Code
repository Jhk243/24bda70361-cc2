from collections import deque, defaultdict
def valid_path(n, edges, source, destination):
 adj = defaultdict(list)
 for u, v in edges:
 adj[u].append(v)
 adj[v].append(u)
 visited = [False] * n
 q = deque([source])
 visited[source] = True
 while q:
 node = q.popleft()
 if node == destination:
 return True
 for nbr in adj[node]:
 if not visited[nbr]:
 visited[nbr] = True
 q.append(nbr)
 return False
print(valid_path(3, [[0, 1], [1, 2], [2, 0]], 0, 2))
